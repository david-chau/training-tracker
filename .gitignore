.DS_Store

# Points at one specific spreadsheet — never shared.
.clasp.json

# Spreadsheet exports and scratch copies. The one template that ships
# lives at docs/download/ and is generated by data/build_template.py.
*.xlsx
!docs/download/training-tracker-template.xlsx

# A second manifest at the repo root shadows the real one in src/,
# which is where clasp reads it from (rootDir).
/appsscript.json

__pycache__/
.venv/
venv/
node_modules/

# Bug-report screenshots, kept locally
/issue_*.jpeg

# Screen-recording sources. The silent GIF/MP4 under docs/img/ are what ship.
/example.mp4

# The admin URL embeds the edit key — the write credential for a log.
e2e/targets.json
node_modules/
test-results/
playwright-report/
/playwright/.cache/

# Scratch dir for clip recording
.clips/

# Anything generated for a look — reports, renders, scratch output
/generated/
